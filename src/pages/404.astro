---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout title="Not found">
  <section class="page-heading">
    <div class="container page-heading-inner">
      <h1>Not found.</h1>
      <p>This page wandered off. Try the home page or browse the notes.</p>
    </div>
  </section>
  <div class="container" style="padding: 3rem 0 8rem;"><a class="text-link" href={`${base}/`}>Back home <span aria-hidden="true">↗</span></a></div>
</BaseLayout>
