---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PaperTagTools from '../../components/papers/PaperTagTools.astro';
import '../../styles/papers.css';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<BaseLayout title="论文标签管理" description="手工维护论文标签与分类。" lang="zh-CN">
  <section class="container paper-detail paper-tag-manager">
    <a class="text-link" href={`${base}/papers/`}>← Paper Library</a>
    <h1>标签管理</h1>
    <p>统一维护标签名称。改名保留论文关联；删除标签会移除全部关联，不影响论文分析。</p>
    <PaperTagTools />
    {import.meta.env.DEV ? <><form class="paper-tag-create" data-tag-create>
      <label>新增标签<input name="name" required maxlength="60" placeholder="输入你自己的分类名称" autocomplete="off" /></label>
      <button class="paper-tag-button" type="submit">创建标签</button>
    </form>
    <div data-tag-manager-list aria-label="全部标签"></div></> : <p>标签编辑仅在本机开发模式开放。请运行 npm run dev 后打开此页面。</p>}
    <noscript><p>标签管理需要启用 JavaScript。</p></noscript>
  </section>
</BaseLayout>
