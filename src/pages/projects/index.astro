---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectRow from '../../components/ProjectRow.astro';
import projects from '../../../data/projects.json';
import site from '../../../data/site.json';

const categories = [...new Set(projects.map((project) => project.category))].sort();
const groupedProjects = categories.map((category) => ({
  category,
  projects: projects
    .filter((project) => project.category === category)
    .sort((a, b) => Number(b.featured ?? false) - Number(a.featured ?? false))
}));
let index = 0;
---

<BaseLayout title="Projects" description="A selection of Wudi's experiments, tools, and open-source projects.">
  <section class="page-heading" aria-labelledby="projects-title">
    <div class="container page-heading-inner">
      <h1 id="projects-title">Projects</h1>
      <p>{site.projectsDescription}</p>
    </div>
  </section>
  <div class="container projects-page">
    {groupedProjects.map((group) => (
      <section class="project-group" aria-labelledby={`group-${group.category}`}>
        <h2 id={`group-${group.category}`}>{group.category}</h2>
        <div class="project-list">
          {group.projects.map((project) => {
            const currentIndex = index++;
            return <ProjectRow project={project} index={currentIndex} />;
          })}
        </div>
      </section>
    ))}
  </div>
</BaseLayout>
