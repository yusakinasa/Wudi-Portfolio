---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NoteCard from '../../components/NoteCard.astro';
import { getCollection } from 'astro:content';
import site from '../../../data/site.json';

const notes = (await getCollection('notes', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const categories = [...new Set(notes.map((note) => note.data.category))].sort();
---

<BaseLayout title="Notes" description="Notes on programming, AI, Linux, frontend work, and learning in public.">
  <section class="page-heading" aria-labelledby="notes-title">
    <div class="container page-heading-inner">
      <h1 id="notes-title">Notes</h1>
      <p>{site.notesDescription}</p>
    </div>
  </section>
  <section class="notes-page container" aria-label="Browse notes" data-notes-browser>
    <div class="filter-bar" role="group" aria-label="Filter by category">
      <button class="filter-button" type="button" data-filter="all" aria-pressed="true">All</button>
      {categories.map((category) => <button class="filter-button" type="button" data-filter={category} aria-pressed="false">{category}</button>)}
    </div>
    <div class="notes-list">
      {notes.map((note) => <NoteCard note={note} />)}
    </div>
    <p class="empty-state" hidden>No notes in this category yet.</p>
  </section>
  <script>
    const browser = document.querySelector<HTMLElement>('[data-notes-browser]');

    if (browser) {
      const buttons = Array.from(browser.querySelectorAll<HTMLButtonElement>('[data-filter]'));
      const cards = Array.from(browser.querySelectorAll<HTMLElement>('.note-card[data-category]'));
      const empty = browser.querySelector<HTMLElement>('.empty-state');

      const applyFilter = (selected: string) => {
        let visible = 0;

        buttons.forEach((button) => {
          button.setAttribute('aria-pressed', String(button.dataset.filter === selected));
        });

        cards.forEach((card) => {
          const show = selected === 'all' || card.dataset.category === selected;
          card.hidden = !show;
          if (show) visible += 1;
        });

        if (empty) empty.hidden = visible !== 0;
      };

      buttons.forEach((button) => {
        button.addEventListener('click', () => applyFilter(button.dataset.filter ?? 'all'));
      });
    }
  </script>
</BaseLayout>
