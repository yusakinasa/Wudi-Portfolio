---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const notes = await getCollection('notes', ({ data }) => !data.draft);
  return notes.map((note) => ({ params: { slug: note.id }, props: { note } }));
}

const { note } = Astro.props;
const { Content } = await render(note);
const allNotes = (await getCollection('notes', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const noteIndex = allNotes.findIndex((item) => item.id === note.id);
const previous = allNotes[noteIndex + 1];
const next = allNotes[noteIndex - 1];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const formattedDate = note.data.date.toLocaleDateString('en', { year: 'numeric', month: 'long', day: 'numeric' });
---

<BaseLayout title={note.data.title} description={note.data.description}>
  <article class="article-wrap">
    <header class="article-header">
      <p class="eyebrow">{note.data.category}</p>
      <h1>{note.data.title}</h1>
      <div class="article-meta">
        <span>{formattedDate}</span>
        {note.data.tags.map((tag) => <span>#{tag}</span>)}
      </div>
    </header>
    <div class="prose"><Content /></div>
    <footer class="article-footer">
      <a href={`${base}/notes`}>← All notes</a>
      <div>
        {previous && <a href={`${base}/notes/${previous.id}`}>Previous</a>}
        {previous && next && <span> · </span>}
        {next && <a href={`${base}/notes/${next.id}`}>Next →</a>}
      </div>
    </footer>
  </article>
</BaseLayout>
