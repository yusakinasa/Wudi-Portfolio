---
import navigation from '../../data/navigation.json';
import site from '../../data/site.json';

const items = navigation
  .filter((item) => item.enabled)
  .sort((a, b) => a.order - b.order);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const currentPath = Astro.url.pathname.replace(base, '') || '/';
const hrefFor = (path: string) => `${base}${path === '/' ? '/' : path}`;
---

<header class="site-header">
  <div class="container nav-wrap">
    <a class="wordmark" href={hrefFor('/')} aria-label={`${site.name} home`}>
      <span class="wordmark-mark" aria-hidden="true">/</span>{site.name}
    </a>
    <nav aria-label="Primary navigation">
      <ul class="nav-list">
        {items.map((item) => (
          <li>
            <a
              href={hrefFor(item.path)}
              class:list={{ active: currentPath === item.path || (item.path !== '/' && currentPath.startsWith(`${item.path}/`)) }}
              aria-current={currentPath === item.path || (item.path !== '/' && currentPath.startsWith(`${item.path}/`)) ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>
