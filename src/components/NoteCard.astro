---
interface Note {
  id: string;
  data: {
    title: string;
    description: string;
    date: Date;
    category: string;
    tags: string[];
  };
}

const { note } = Astro.props as { note: Note };
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const notePath = `/notes/${note.id}`;
---

<article class="note-card" data-category={note.data.category}>
  <div class="note-card-date"><time datetime={note.data.date.toISOString()}>{note.data.date.toLocaleDateString('en', { year: 'numeric', month: 'short', day: 'numeric' })}</time></div>
  <div>
    <p class="note-category">{note.data.category}</p>
    <h3><a href={`${base}${notePath}`}>{note.data.title}</a></h3>
    <p class="note-description">{note.data.description}</p>
    <ul class="tag-list" aria-label={`${note.data.title} tags`}>
      {note.data.tags.map((tag) => <li>{tag}</li>)}
    </ul>
  </div>
  <a class="arrow-link" href={`${base}${notePath}`} aria-label={`Read ${note.data.title}`}>Read <span aria-hidden="true">↗</span></a>
</article>
