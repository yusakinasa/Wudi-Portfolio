---
import site from '../../data/site.json';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<footer class="site-footer">
  <div class="container footer-wrap">
    <p>© {new Date().getFullYear()} {site.name}. Built with Astro.</p>
    <div class="footer-links">
      {site.socialLinks.map((link) => <a href={link.href}>{link.label}</a>)}
    </div>
    <a class="back-top" href={`${base}/#top`}>Back to top ↑</a>
  </div>
</footer>
