---
interface Experience {
  id: string;
  data: {
    title: string;
    description: string;
    date: Date;
    category: string;
    tags: string[];
  };
}

const { entry } = Astro.props as { entry: Experience };
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const entryPath = `${base}/experience/${entry.id}`;
const formattedDate = entry.data.date.toLocaleDateString('zh-CN', {
  year: 'numeric',
  month: '2-digit',
  day: '2-digit'
});
---

<article class="experience-row">
  <div class="experience-date"><time datetime={entry.data.date.toISOString()}>{formattedDate}</time></div>
  <div class="experience-main">
    <p class="note-category">{entry.data.category}</p>
    <h2><a href={entryPath}>{entry.data.title}</a></h2>
    <p>{entry.data.description}</p>
    <ul class="tag-list" aria-label={`${entry.data.title} 标签`}>
      {entry.data.tags.map((tag) => <li>{tag}</li>)}
    </ul>
  </div>
  <a class="arrow-link" href={entryPath} aria-label={`阅读：${entry.data.title}`}>阅读 <span aria-hidden="true">↗</span></a>
</article>
