# These variables are read from the environment, not automatically from this file.
# Copy to .env and load it in your shell; never commit credentials.
PAPER_CACHE_DIR=.cache/papers
# auto prefers the installed local MinerU 4 CLI. A configured MinerU failure does
# not silently fall back. pymupdf is an explicit lightweight/offline alternative.
PAPER_PARSER=auto
PAPER_MINERU_BIN=
# Empty uses the normal local default (standard/basic), never flash or remote.
PAPER_MINERU_TIER=
PAPER_MINERU_TIMEOUT=900
PAPER_CODEX_BIN=codex
PAPER_CODEX_TIMEOUT=1200
PAPER_CODEX_HEARTBEAT_SECONDS=15
# Default: delete each Codex task directory after success, failure or cancellation.
# Set to 1 only to retain prompt/stdout/stderr/raw output for debugging a new run.
PAPER_KEEP_ANALYSIS_LOGS=0
# Explicit defaults; also used if these environment variables are unset/empty.
PAPER_CODEX_MODEL=gpt-6.1-sol
PAPER_CODEX_REASONING_EFFORT=high
# Export CODEX_HOME in your shell if you use a non-default Codex configuration directory.
# The program displays the effective path; it does not guess shell function profiles.
# Normally auto-detected from the CLI's non-secret config selector (not credentials).
PAPER_CODEX_AUTH_STORE=
# Local Zotero API (enable Allow other applications ... in Zotero settings).
ZOTERO_LOCAL_API=http://localhost:23119/api/users/0
ZOTERO_STORAGE_DIR=~/Zotero/storage
# Optional Web API fallback: metadata only; attachments still come from local storage.
ZOTERO_USER_ID=
ZOTERO_API_KEY=
